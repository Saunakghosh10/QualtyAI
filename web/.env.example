# QualtyAI web — environment

# Supabase (Qualty's own project, never the CargoFirst one). Both values are public and safe in the browser.
# Leave them empty to run the browser-only demo (data stays in this browser; used by tests and CI).
NEXT_PUBLIC_SUPABASE_URL=https://efluggnkkjlrjnsbicyq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only, never prefixed with NEXT_PUBLIC_. Needed only for the live backend test
# (e2e/live) and scripts/make-admin.mjs. Don't put it in Vercel.
# SUPABASE_SECRET_KEY=

# Public site URL (for canonical tags and metadata)
NEXT_PUBLIC_SITE_URL=https://qualty.ai
